# Project Sentinel MVP — Environment Variables
# Copy this file to .env and fill in the values.

# Groq API Key (get from: https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# LLM model to use for RCA (default: llama-3.3-70b-versatile)
LLM_MODEL=llama-3.3-70b-versatile

# --- Dual-Path Slack Webhooks ---

# Raw Monitoring: Alertmanager sends unfiltered alerts here (#raw-monitoring)
RAW_MONITORING_WEBHOOK=https://hooks.slack.com/services/YOUR/RAW/WEBHOOK

# Sentinel Ops: Cloud Architect sends AI RCA reports here (#sentinel-ops)
SENTINEL_OPS_WEBHOOK=https://hooks.slack.com/services/YOUR/OPS/WEBHOOK
